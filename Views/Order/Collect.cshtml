@model CollectRequest

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h1 class="h4 mb-0">🍽️ Collect Meal</h1>
            </div>
            <div class="card-body">
                <p class="text-muted">Enter the Order ID of the meal you want to collect (e.g. <code>O002</code>).</p>

                <form asp-controller="Order" asp-action="Collect" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="OrderID" class="form-label"></label>
                        <input asp-for="OrderID" class="form-control form-control-lg" placeholder="O001" autofocus autocomplete="off" />
                        <span asp-validation-for="OrderID" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg flex-grow-1">Collect</button>
                        <a class="btn btn-outline-secondary btn-lg" asp-controller="Home" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-white small text-muted">
                If you don't know your Order ID, you can find it in the <a asp-controller="Order" asp-action="Index">list of all orders</a>.
            </div>
        </div>
    </div>
</div>
