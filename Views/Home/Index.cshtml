@model List<MealOrder>
@{
    ViewData["Title"] = "Home";
}

<div class="p-4 p-md-5 mb-4 rounded-3 bg-white shadow-sm border">
    <h1 class="display-6 fw-bold text-primary">@ViewBag.CafeteriaName</h1>
    <p class="lead mb-1">Today's date: <strong>@ViewBag.CurrentDate</strong></p>
    <p class="text-muted mb-4">Use your Order ID to collect your prepared meal order.</p>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-success btn-lg" asp-controller="Order" asp-action="Collect">🍽️ Collect Meal</a>
        <a class="btn btn-outline-primary btn-lg" asp-controller="Order" asp-action="Index">📋 All Orders</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-1 text-white-50">Number of Collected Orders</h6>
                <p class="display-5 fw-bold mb-0">@ViewData["CollectedCount"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-bg-secondary h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-1 text-white-50">Total Number of Orders</h6>
                <p class="display-5 fw-bold mb-0">@ViewData["TotalCount"]</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Collected Meal Orders</h2>
        <span class="badge bg-success rounded-pill">@Model.Count record(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order ID</th>
                    <th>Student Name</th>
                    <th>Meal Name</th>
                    <th>Collected At</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No meal orders have been collected yet.</td>
                    </tr>
                }
                @foreach (var order in Model)
                {
                    <tr>
                        <td><code>@order.OrderID</code></td>
                        <td>@order.StudentName</td>
                        <td>@order.MealName</td>
                        <td>@order.CollectedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderID">Collection Info</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Footer {
    @* Home page footer: developer information *@
    <partial name="_DeveloperFooter" />
}
